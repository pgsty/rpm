Subject: Set the package version and preserve vcpkg dependency debug information

--- a/cmake/GitVersion.cmake
+++ b/cmake/GitVersion.cmake
@@ -7,0 +8,5 @@
+  if(DEFINED PG_STAT_CH_PACKAGE_VERSION)
+    set(${output_var} "${PG_STAT_CH_PACKAGE_VERSION}" PARENT_SCOPE)
+    return()
+  endif()
+
--- a/triplets/arm64-linux-pic.cmake
+++ b/triplets/arm64-linux-pic.cmake
@@ -5,2 +5,3 @@
-set(VCPKG_CXX_FLAGS "-fPIC")
-set(VCPKG_C_FLAGS "-fPIC")
+set(VCPKG_BUILD_TYPE release)
+set(VCPKG_CXX_FLAGS "-fPIC -g")
+set(VCPKG_C_FLAGS "-fPIC -g")
--- a/triplets/x64-linux-pic.cmake
+++ b/triplets/x64-linux-pic.cmake
@@ -5,2 +5,8 @@
-set(VCPKG_CXX_FLAGS "-fPIC")
-set(VCPKG_C_FLAGS "-fPIC")
+set(VCPKG_BUILD_TYPE release)
+set(VCPKG_CXX_FLAGS "-fPIC -g")
+set(VCPKG_C_FLAGS "-fPIC -g")
+
+# EL10 Snappy enables AVX while its BMI2 configuration omits this header.
+if(PORT STREQUAL "snappy")
+  set(VCPKG_CXX_FLAGS "${VCPKG_CXX_FLAGS} -include immintrin.h")
+endif()
