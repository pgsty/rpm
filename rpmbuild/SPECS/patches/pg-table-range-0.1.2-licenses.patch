+#!/usr/bin/env python3
+"""Collect reviewed licenses for the active Cargo normal dependency closure.
+
+Python 3.6 compatible; no network, TOML parser or external Python dependencies.
+The policy pins complete license texts, including release omissions recovered
+from upstream. New crates, versions, declarations or altered texts fail closed.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import re
+import shutil
+import sys
+
+
+def require(condition, message):
+    if not condition:
+        raise ValueError(message)
+
+
+def read_json(path):
+    with path.open(encoding="utf-8") as stream:
+        return json.load(stream)
+
+
+def checked_path(root, relative):
+    path = (root / relative).resolve()
+    require(root.resolve() in path.parents, "Path escapes its source: " + relative)
+    require(path.is_file(), "Missing license file: " + str(path))
+    return path
+
+
+def collect(args):
+    packaging = Path(__file__).resolve().parent
+    policy = read_json(packaging / "license-policy.json")
+    metadata = read_json(Path(args.metadata))
+    require(int(args.pg[2:]) in policy["pg"], "Unreviewed PostgreSQL feature")
+    require(args.target in ("aarch64-unknown-linux-gnu", "x86_64-unknown-linux-gnu"),
+            "Unreviewed target platform")
+    packages = {p["id"]: p for p in metadata["packages"]}
+    nodes = {n["id"]: n for n in metadata["resolve"]["nodes"]}
+    root_id = metadata["resolve"]["root"]
+    root = packages[root_id]
+    require((root["name"], root["version"], root["license"]) ==
+            (policy["project"], policy["version"], policy["root_license"]),
+            "Unexpected root package")
+    features = sorted(f for f in nodes[root_id]["features"] if re.fullmatch(r"pg\d+", f))
+    require(features == [args.pg], "Cargo metadata has unexpected PostgreSQL features")
+    # Cargo --filter-platform has already removed inapplicable target edges.
+    # Follow normal edges only: build/dev-only tools are not distributed.
+    # Proc macro normal edges are retained conservatively for generated code.
+    pending, closure = [root_id], set()
+    while pending:
+        ident = pending.pop()
+        if ident in closure:
+            continue
+        closure.add(ident)
+        for dep in nodes[ident]["deps"]:
+            if any(kind["kind"] in (None, "normal") for kind in dep["dep_kinds"]):
+                pending.append(dep["pkg"])
+    output = Path(args.output)
+    require(not output.exists(), "Refusing to merge stale license output: " + str(output))
+    output.mkdir(parents=True)
+    entries, licenses = [], set(policy["root_license"].split(" AND "))
+    for ident in sorted(closure - {root_id}):
+        package = packages[ident]
+        key = package["name"] + "-" + package["version"]
+        require(key in policy["packages"], "Unreviewed dependency: " + key)
+        reviewed = policy["packages"][key]
+        require(package["source"] == "registry+https://github.com/rust-lang/crates.io-index",
+                "Unreviewed dependency source: " + key)
+        require(package["license"] == reviewed["declared"], "License changed: " + key)
+        crate = Path(package["manifest_path"]).resolve().parent
+        destination = output / key
+        destination.mkdir()
+        files = []
+        require(bool(reviewed["files"]), "No reviewed license text: " + key)
+        for document in reviewed["files"]:
+            origin = document["from"]
+            require(origin in ("crate", "packaging"), "Unknown license origin")
+            source = checked_path(crate if origin == "crate" else packaging, document["path"])
+            digest = hashlib.sha256(source.read_bytes()).hexdigest()
+            require(digest == document["sha256"], "License text changed: " + str(source))
+            relative = Path(origin) / document["path"]
+            target = destination / relative
+            target.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copyfile(str(source), str(target))
+            files.append(dict(document, installed_path=str(Path(key) / relative)))
+        # REUSE puts actual copyright holders in source headers rather than in
+        # its generic MIT.txt. Preserve those exact lines with their source path.
+        copyrights = []
+        for source in sorted(crate.rglob("*")):
+            if not source.is_file() or source.suffix not in (".rs", ".c", ".h", ".S"):
+                continue
+            lines = [line for line in source.read_text(encoding="utf-8").splitlines()
+                     if "SPDX-FileCopyrightText:" in line]
+            if lines:
+                copyrights.append(str(source.relative_to(crate)) + "\n" + "\n".join(lines))
+        if copyrights:
+            (destination / "SPDX-COPYRIGHTS.txt").write_text("\n\n".join(copyrights) + "\n", encoding="utf-8")
+        # Upstream authors are attribution data, never fabricated copyright text.
+        (destination / "AUTHORS.txt").write_text("\n".join(package["authors"]) + "\n", encoding="utf-8")
+        for vendor in reviewed.get("vendored", []):
+            require((crate / vendor["path"]).is_dir(), "Missing reviewed vendored source: " + key)
+            licenses.update(vendor["license"].split(" AND "))
+        licenses.update(reviewed["selected"].split(" AND "))
+        entries.append({"name": package["name"], "version": package["version"],
+                        "declared_license": package["license"], "selected_license": reviewed["selected"],
+                        "repository": package["repository"], "authors": package["authors"],
+                        "documents": files, "vendored": reviewed.get("vendored", [])})
+    expression = " AND ".join(sorted(licenses))
+    require(expression == policy["license_expression"] == args.expected_license,
+            "RPM License field does not match the selected dependency licenses: " + expression)
+    manifest = {"project": policy["project"], "version": policy["version"],
+                "pg_feature": args.pg, "target": args.target,
+                "scope": "Cargo normal dependency closure, including proc macros and vendored native code",
+                "license_expression": expression, "packages": entries}
+    (output / "manifest.json").write_text(json.dumps(manifest, sort_keys=True, indent=2) + "\n", encoding="utf-8")
+    print("Collected {} dependency licenses: {}".format(len(entries), expression))
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("metadata")
+    parser.add_argument("--pg", required=True, choices=["pg16", "pg17", "pg18"])
+    parser.add_argument("--target", required=True)
+    parser.add_argument("--expected-license", required=True)
+    parser.add_argument("--output", default="THIRD_PARTY_LICENSES")
+    try:
+        collect(parser.parse_args())
+    except (KeyError, OSError, ValueError) as error:
+        sys.exit("License collection failed: " + str(error))
