#!/bin/bash
# set -o pipefail
#==============================================================#
# File      :   build
# Desc      :   build an extension (on el systems)
# Ctime     :   2024-10-13
# Mtime     :   2026-09-03
# Usage     :   build <extension> [debug|dbg] <versions...>
# Author    :   Ruohang Feng (rh@vonng.com)
# License   :   Apache-2.0
#==============================================================#
PROG_NAME="$(basename $0)"
PROG_DIR="$(cd $(dirname $0) && pwd)"
SPEC_DIR="${PROG_DIR}/SPECS"
RPMS_DIR="${PROG_DIR}/RPMS"
SOURCES_DIR="${PROG_DIR}/SOURCES"

#--------------------------------------------------------------#
# Usage
#--------------------------------------------------------------#
# build <extension> [debug|dbg] [versions...]
# ./build pg_roaringbitmap         14 15 16 17 18
# ./build pgjwt            debug   14 15 16 17 18

#--------------------------------------------------------------#
# Log Util
#--------------------------------------------------------------#
# if output is a terminal, setup color alias, else use empty str
if [[ -t 1 ]]; then
    __CN='\033[0m';__CB='\033[0;30m';__CR='\033[0;31m';__CG='\033[0;32m';
    __CY='\033[0;33m';__CB='\033[0;34m';__CM='\033[0;35m';__CC='\033[0;36m';__CW='\033[0;37m';
else
    __CN='';__CB='';__CR='';__CG='';__CY='';__CB='';__CM='';__CC='';__CW='';
fi
function log_info()  { printf "[${__CG} OK ${__CN}] ${__CG}%s${__CN}\n" "$*"; }
function log_warn()  { printf "[${__CY}WARN${__CN}] ${__CY}%s${__CN}\n" "$*"; }
function log_error() { printf "[${__CR}FAIL${__CN}] ${__CR}%s${__CN}\n" "$*"; }
function log_red()   { printf "[${__CR}WARN${__CN}] ${__CR}%s${__CN}\n" "$*"; }
function log_debug() { printf "[${__CB}HINT${__CN}] ${__CB}%s${__CN}\n" "$*"; }
function log_title() { printf "[${__CG}%s${__CN}] ${__CG}%s${__CN}\n" "$1" "$2"; }
function log_hint()  { printf "${__CB}%s${__CN}\n" "$*"; }
function log_line()  { printf "${__CM}[%s] ===========================================${__CN}\n" "$*"; }

function stage_declared_patches() {
    if [[ ! -d "${SOURCES_DIR}" ]]; then
        log_error "RPM SOURCES directory is missing: ${SOURCES_DIR}"
        return 1
    fi

    declare -A declared_patches=()
    local ver preprocessed patch_list patch_file local_patch source_patch
    for ver in ${VERSIONS}; do
        if ! preprocessed=$(mktemp) || ! patch_list=$(mktemp); then
            log_error "cannot create Patch manifest for ${EXTENSION_NAME} PG${ver}"
            rm -f "${preprocessed:-}" "${patch_list:-}"
            return 1
        fi
        if ! rpmspec -P \
            --define "_topdir ${PROG_DIR}" \
            --define "pgmajorversion ${ver}" "${SPEC_FILE}" >"${preprocessed}"; then
            rm -f "${preprocessed}" "${patch_list}"
            log_error "cannot expand declared patches for ${EXTENSION_NAME} PG${ver}"
            return 1
        fi
        if ! awk '/^Patch[0-9]*[[:space:]]*:/ {
            line=$0
            sub(/^Patch[0-9]*[[:space:]]*:[[:space:]]*/, "", line)
            print line
        }' "${preprocessed}" >"${patch_list}"; then
            rm -f "${preprocessed}" "${patch_list}"
            log_error "cannot parse declared patches for ${EXTENSION_NAME} PG${ver}"
            return 1
        fi
        while IFS= read -r patch_file; do
            [[ -z "${patch_file}" || "${patch_file}" == "(none)" ]] && continue
            declared_patches["${patch_file}"]=1
        done <"${patch_list}"
        rm -f "${preprocessed}" "${patch_list}"
    done

    for patch_file in "${!declared_patches[@]}"; do
        if [[ "${patch_file}" == -* || ! "${patch_file}" =~ ^[A-Za-z0-9._+~-]+$ ]]; then
            log_error "unsafe or unexpanded Patch path: ${patch_file}"
            return 1
        fi
        local_patch="${SPEC_DIR}/patches/${patch_file}"
        if [[ ! -f "${local_patch}" || ! -s "${local_patch}" || -L "${local_patch}" ]]; then
            log_error "declared repository Patch is missing or empty: ${patch_file}"
            return 1
        fi
        source_patch="${SOURCES_DIR}/${patch_file}"
        if [[ -L "${source_patch}" ]]; then
            log_error "refusing symlink Patch destination: ${source_patch}"
            return 1
        fi
    done

    for patch_file in "${!declared_patches[@]}"; do
        local_patch="${SPEC_DIR}/patches/${patch_file}"
        source_patch="${SOURCES_DIR}/${patch_file}"
        if ! cp -f -- "${local_patch}" "${source_patch}"; then
            log_error "cannot stage repository Patch: ${patch_file}"
            return 1
        fi
        if [[ ! -f "${source_patch}" || ! -s "${source_patch}" ]] || \
           ! cmp -s -- "${local_patch}" "${source_patch}"; then
            log_error "staged Patch does not match repository input: ${patch_file}"
            return 1
        fi
    done
}


#--------------------------------------------------------------#
# ARGS
#--------------------------------------------------------------#
EXTENSION_NAME=$1
shift

# Debug packages are now the default. Keep the historical token as a no-op so
# existing invocations such as `./build pgjwt debug 17` remain compatible.
if [[ "${1:-}" == "debug" || "${1:-}" == "dbg" ]]; then
    shift
fi

# Cargo's optimized release profile omits DWARF by default. Preserve full
# release-mode debug information for rpmbuild to split into debuginfo and
# debugsource packages. Individual specs repeat these defaults so direct
# `rpmbuild -ba` invocations have the same behavior.
export CARGO_PROFILE_RELEASE_DEBUG="${CARGO_PROFILE_RELEASE_DEBUG:-2}"
export CARGO_PROFILE_RELEASE_STRIP="${CARGO_PROFILE_RELEASE_STRIP:-none}"

# Detect OS version for EL10+ special handling
OS_VERSION=$(rpm -E '%{rhel}' 2>/dev/null || echo "0")
if [[ "$OS_VERSION" =~ ^[0-9]+$ ]] && [[ "$OS_VERSION" -ge 10 ]]; then
    export QA_RPATHS=3
fi

VERSIONS=""
if [ $# -eq 0 ]; then
    VERSIONS="14 15 16 17 18"
else

    # Validate versions
    VALID_VERSIONS="14 15 16 17 18"
    for arg in "$@"; do
        found=false
        for ver in ${VALID_VERSIONS}; do
            if [ "${ver}" = "${arg}" ]; then
                found="true"
            fi
        done
        if [[ "${found}" != "true" ]]; then
            log_error "invalid pg version: ${arg}"
            exit 1
        fi
    done
    VERSIONS=$@
fi


#--------------------------------------------------------------#
# Check Spec
#--------------------------------------------------------------#
SPEC_FILE="${SPEC_DIR}/${EXTENSION_NAME}.spec"

if [ -f "${SPEC_FILE}" ]; then
    log_line "${EXTENSION_NAME} spec file"
else
    log_error "rpm spec not found: ${SPEC_FILE}"
    exit 1
fi

cat ${SPEC_FILE} | grep -E '^Version:|^Release:|^Summary:|^License:|^URL:|^Source0:'
if ! stage_declared_patches; then
    log_error "failed to stage declared patches for ${EXTENSION_NAME}"
    exit 1
fi


#--------------------------------------------------------------#
# Check RPMs
#--------------------------------------------------------------#
ARCH=$(uname -m)
for RPM_OUT_DIR in "${RPMS_DIR}/${ARCH}" "${RPMS_DIR}/noarch"; do
    if [ -d "${RPM_OUT_DIR}" ]; then
        log_line "${EXTENSION_NAME} rpms dir"
        ls -alh "${RPM_OUT_DIR}" | grep "${EXTENSION_NAME}"
        log_warn "existing ${EXTENSION_NAME} rpms will be removed"
        log_hint rm -rf "${RPM_OUT_DIR}/${EXTENSION_NAME}"*.rpm
        #rm -rf "${RPM_OUT_DIR}/${EXTENSION_NAME}"*.rpm
    fi
done


#--------------------------------------------------------------#
# Building for each pgmajorversion
#--------------------------------------------------------------#
for ver in $VERSIONS; do
    log_line "${EXTENSION_NAME} for PG$ver"
    export PATH=/usr/bin:/usr/pgsql-${ver}/bin:/root/.cargo/bin:/pg/bin:/usr/share/Modules/bin:/usr/lib64/ccache:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/root/bin:/home/vagrant/.cargo/bin;

    # Build command with proper argument expansion
    log_hint "\$" rpmbuild --define "_topdir ${PROG_DIR}" --define "pgmajorversion ${ver}" -ba "${SPEC_FILE}"
    rpmbuild --define "_topdir ${PROG_DIR}" --define "pgmajorversion ${ver}" -ba "${SPEC_FILE}"
    RC=$?
    if [ "${RC}" -ne 0 ]; then
        log_error "${EXTENSION_NAME} build failed for PG${ver}"
        exit "${RC}"
    fi
done


#--------------------------------------------------------------#
# Print RPM List
#--------------------------------------------------------------#
log_line "${EXTENSION_NAME} rpms"
log_info "${RPMS_DIR}"
ARCH=$(uname -m)
for RPM_OUT_DIR in "${RPMS_DIR}/${ARCH}" "${RPMS_DIR}/noarch"; do
    if [ -d "${RPM_OUT_DIR}" ]; then
        ls -alh "${RPM_OUT_DIR}" | grep "${EXTENSION_NAME}"
    fi
done
log_line "${EXTENSION_NAME} done"
